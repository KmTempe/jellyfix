JELLYFIX_ENV=production
ROOT_PATH=/jellyfix
JELLYFIN_URL=http://jellyfin:8096
PUBLIC_ORIGIN=https://your-jellyfin.example
TRUSTED_HOSTS=your-jellyfin.example
STORAGE_PATH=/data
DATABASE_PATH=/data/tickets.db
ALLOW_ACTIVE_TICKET_DELETION=false
RESOLVED_TICKET_COOLDOWN_SECONDS=300

# Optional Wizarr Reply-To lookup. JellyFix calls /api/users?username=<Jellyfin name>
# and accepts only one exact Jellyfin username match with a valid email address.
# Mount the token file as a Docker secret; never put the token in this file.
WIZARR_BASE_URL=
WIZARR_TOKEN_FILE=/run/secrets/wizarr_api_key
WIZARR_TIMEOUT_SECONDS=5
WIZARR_CACHE_TTL_SECONDS=300
# When true, queue notifications until a verified Reply-To address is available.
WIZARR_REPLY_TO_REQUIRED=false

SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
EMAIL_FROM=
EMAIL_TO=
