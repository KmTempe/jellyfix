JELLYFIX_ENV=production
ROOT_PATH=/jellyfix
JELLYFIN_URL=http://jellyfin:8096
PUBLIC_ORIGIN=https://your-jellyfin.example
TRUSTED_HOSTS=your-jellyfin.example
STORAGE_PATH=/data
DATABASE_PATH=/data/tickets.db
ALLOW_ACTIVE_TICKET_DELETION=false
RESOLVED_TICKET_COOLDOWN_SECONDS=300

# Wizarr email lookup. JellyFix calls /api/users?username=<Jellyfin name>
# and accepts only one exact Jellyfin username match with a valid email address.
# Mount the token file as a Docker secret; never put the token in this file.
WIZARR_BASE_URL=
WIZARR_TOKEN_FILE=/run/secrets/wizarr_api_key
WIZARR_TIMEOUT_SECONDS=5
WIZARR_CACHE_TTL_SECONDS=300
# When true, queue LibreDesk conversations until a verified email is available.
WIZARR_EMAIL_REQUIRED=true

# LibreDesk is reached directly through the shared Docker network.
LIBREDESK_BASE_URL=http://libredesk_app:9000
LIBREDESK_CREDENTIAL_FILE=/run/secrets/libredesk_l7feeders_api
LIBREDESK_WEBHOOK_SECRET_FILE=/run/secrets/libredesk_webhook_secret
LIBREDESK_INBOX_ID=1
LIBREDESK_TEAM_ID=1
LIBREDESK_TAG=jellyfix
LIBREDESK_SUBJECT_PREFIX=jellyfin-issue#
LIBREDESK_PUBLIC_URL=
LIBREDESK_TIMEOUT_SECONDS=5
LIBREDESK_RECONCILE_SECONDS=300
